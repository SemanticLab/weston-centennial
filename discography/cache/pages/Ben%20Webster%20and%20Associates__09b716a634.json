<a href=\"/wiki/Verve_Records\" title=\"Verve Records\">Verve</a> label.<sup id=\"cite&#95;ref-1\" class=\"reference\"><a href=\"#cite_note-1\"><span class=\"cite-bracket\">&#91;</span>1<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<meta property=\"mw:PageProp/toc\" />\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Reception\">Reception</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Ben_Webster_and_Associates&amp;action=edit&amp;section=1\" title=\"Edit section: Reception\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<table class=\"wikitable floatright\" style=\"width:24.2em;font-size:88%;text-align:center;margin:0.5em 0 0.5em 1em;padding:0;border-spacing:0\"><caption style=\"font-size:115%\">Professional ratings</caption><tbody><tr><th scope=\"col\" colspan=\"2\" style=\"text-align:center;color:#202122;background:#d1dbdf;font-size:100%\">Review scores</th></tr><tr><th scope=\"col\">Source</th><th scope=\"col\">Rating</th></tr><tr><td style=\"text-align:center;vertical-align:middle\"><i><a href=\"/wiki/Allmusic\" class=\"mw-redirect\" title=\"Allmusic\">Allmusic</a></i></td><td style=\"text-align:center;vertical-align:middle\"><span style=\"white-space:nowrap\" title=\"4.5/5 stars\"><span typeof=\"mw:File\"><span title=\"4.5/5 stars\"><img alt=\"Star\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/5/51/Star_full.svg/20px-Star_full.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"11\" height=\"11\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/5/51/Star_full.svg/40px-Star_full.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"108\" data-file-height=\"110\" /></span></span><span typeof=\"mw:File\"><span><img alt=\"Star\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/5